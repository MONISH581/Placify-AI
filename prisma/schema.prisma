// Placify-AI database schema (SQLite via Prisma).
// DATABASE_URL is read from the root .env; a relative "file:./dev.db" resolves to prisma/dev.db.
// Apply changes with `npx prisma db push` (or `npm run setup`), then `npx prisma generate`.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  username       String  @unique
  password       String
  isAdmin        Boolean @default(false)
  xp             Int     @default(0)
  level          Int     @default(1)
  streak         Int     @default(0)
  lastActiveDate String // YYYY-MM-DD (UTC)
  accuracy       Int     @default(0) // accepted submissions / total submissions * 100
  verified       Boolean @default(false)

  badges              Badge[]
  problemsSolved      Problem[]             @relation("SolvedProblems")
  submissions         Submission[]
  mockInterviews      MockInterview[]
  discussions         DiscussionThread[]
  contestRegistrations ContestRegistration[]
  topicCompletions    TopicCompletion[]
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  criteria    String
  awardedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Problem {
  id           String  @id @default(uuid())
  title        String
  difficulty   String // Easy | Medium | Hard
  description  String
  constraints  String
  inputFormat  String
  outputFormat String
  editorial    String?

  // JSON-encoded columns (SQLite has no native JSON/array type)
  tags        String // string[] (topic + company tags)
  examples    String // { input, output, explanation? }[]
  testCases   String // { input, expectedOutput, isHidden }[]
  hints       String // string[]
  starterCode String @default("{}") // { javascript, python, java, cpp, c }
  solutions   String @default("{}") // { javascript, python, java, cpp, c }

  submissions   Submission[]
  solvedByUsers User[]       @relation("SolvedProblems")
}

model Submission {
  id             String  @id @default(uuid())
  language       String
  code           String
  status         String // Accepted | Wrong Answer | Runtime Error | Time Limit Exceeded | Compilation Error
  timeComplexity String?
  memoryUsage    String?
  errorMessage   String?
  submittedAt    String // ISO timestamp
  xpEarned       Int     @default(0)
  aiReview       String?

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
  @@index([problemId])
}

model MockInterview {
  id                   String  @id @default(uuid())
  type                 String // Technical | HR | Behavioral
  status               String // In Progress | Completed
  currentQuestionIndex Int     @default(0)
  createdAt            String // ISO timestamp
  overallScore         Float?
  overallFeedback      String?
  xpEarned             Int     @default(0)

  // JSON-encoded arrays
  questions String
  answers   String
  scores    String
  feedback  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiscussionThread {
  id        String @id @default(uuid())
  title     String
  content   String
  username  String
  category  String
  likes     Int    @default(0)
  createdAt String // ISO timestamp
  likedBy   String // JSON-encoded string[] of user ids

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]
}

model Reply {
  id        String  @id @default(uuid())
  username  String
  content   String
  createdAt String // ISO timestamp
  userId    String?

  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Contest {
  id              String @id @default(uuid())
  title           String
  description     String
  startTime       String // ISO timestamp
  durationMinutes Int
  problems        String // JSON-encoded string[] of problem ids

  registrations ContestRegistration[]
}

model ContestRegistration {
  id           String   @id @default(uuid())
  registeredAt DateTime @default(now())

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model TopicCompletion {
  id          String   @id @default(uuid())
  trackId     String
  topicId     String
  quizScore   Int
  xpEarned    Int
  completedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, topicId])
}
