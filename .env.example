# Placify-AI environment configuration.
# `npm run setup` copies this file to .env and fills JWT_SECRET / INTERNAL_API_KEY with random values.
# The same root .env is read by the Node server and by the Python ML service (ml_service/).

# NODE_ENV: development | production | test. Leave unset: `npm run dev` runs as development and
# `npm start` (dist/server.cjs) defaults to production. Demo accounts are only seeded outside production.
# NODE_ENV=development

# Node server bind address and port (127.0.0.1 = only reachable from this machine).
HOST=127.0.0.1
PORT=3000

# SQLite database. Relative paths are resolved from the prisma/ folder, so this is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# REQUIRED secrets - no defaults. Generated by `npm run setup`; use long random values (>= 32 chars for JWT_SECRET).
JWT_SECRET=
INTERNAL_API_KEY=

# Python ML microservice (Node sends X-API-Key: INTERNAL_API_KEY on every call).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_HOST=127.0.0.1
ML_PORT=8000

# Comma-separated origins allowed to call the API cross-origin (same-origin requests need nothing).
ALLOWED_ORIGINS=http://localhost:3000

# Optional Google Gemini integration (code reviews, resume analysis, learning content). Empty = disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Code runner: judge0 | local | (empty = judge0 when JUDGE0_API_URL is set, else local outside production).
# The local runner is for LOCAL DEVELOPMENT ONLY (JavaScript + Python). Use Judge0 in production.
CODE_RUNNER=
# Optional Python interpreter for the local runner (default: python / py -3 on Windows, python3 elsewhere).
PYTHON_BIN=

# Optional Judge0 (e.g. https://judge0-ce.p.rapidapi.com). Leave empty to disable.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional rate limits (requests per minute per IP).
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30
