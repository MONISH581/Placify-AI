# Placify Full-Stack Environment Configuration Template

# Server Port
PORT=3000

# Database Connection (SQLite Prisma)
DATABASE_URL="file:./dev.db"

# JWT Secret Key (Change in production)
JWT_SECRET=your_jwt_secret_key_here

# Internal Microservice Shared Secret Key
INTERNAL_API_KEY=your_internal_api_key_here

# Python ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Optional Google Gemini AI Integration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_optional_gemini_api_key

# Optional Code Judge0 API Integration
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_optional_judge0_key
